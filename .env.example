# Two LLM steps run in one pipeline: Person 2's candidate filter and Person 3's
# stylist. Give them SEPARATE API KEYS. They share a quota otherwise, and a
# single run makes both of them fail with 429 Too Many Requests. Copying the
# same key into both names below does not separate anything - it is one key
# under two names. `node logic/run-pipeline.mjs` says which key each step uses
# and warns when they are the same.

# Step 1, the candidate filter (and the trust check).
ZAI_API_KEY=
ZAI_BASE_URL=
ZAI_MODEL=
ZAI_MODEL_PROVIDER_NAME=

# Step 4, the stylist. A different key from ZAI_API_KEY, on a different
# account. Base URL and model fall back to the ZAI_ values when left empty.
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=
# Model the pipeline retries with when ZAI_MODEL answers "high demand" (503)
# or 429; unset, a retry asks the same model again.
AITELIER_FALLBACK_MODEL=
ZAI_CONTEXT_WINDOW_TOKENS=
BLOCKFROST_API_KEY_PREPROD=
EVE_PORT=21949
EVE_URL=http://127.0.0.1:21949
COWORKER_ID=
SOKOSUMI_ORGANIZATION_ID=
SOKOSUMI_ORGANIZATION_SLUG=
AGENT_AUTHOR=

# Chat checkout (logic/checkout.mjs). Unset or "off": the agent shows every shop
# link and buys nothing. "mock": it answers "paid" without moving money, which
# the chat says out loud — for demos without a wallet. A path from the
# repository root wires in the payment module; it must export
# payOutfit(purchase) -> { status: "paid" | "declined" | "failed", txHash? }.
AITELIER_PAYMENT=

MPS_PORT=38127
MPS_URL=http://127.0.0.1:38127

AGENT_API_PORT=21950
PAID_TASKS_ENABLED=false

# Sokosumi MCP (local Preprod container)
SOKOSUMI_NETWORK=preprod
SOKOSUMI_API_KEY=

# Result pages on Cloudflare Pages (logic/publish.mjs). Without these, results carry no page link.
# Log in once with: node_modules/.bin/wrangler login --scopes account:read user:read pages:write --use-keyring
# (or set CLOUDFLARE_API_TOKEN: a custom token with Account / Cloudflare Pages / Edit).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
AITELIER_PAGES_PROJECT=aitelier-results
