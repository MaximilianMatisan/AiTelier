{
  "name": "aitelier",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env start.mjs",
    "worker": "node --env-file-if-exists=.env worker.mjs",
    "api": "node --env-file-if-exists=.env --env-file-if-exists=.local/mps-runtime.env agent-api.mjs",
    "ui": "node --env-file-if-exists=.env ui/server.mjs",
    "shop": "node --env-file-if-exists=.env mock-shop/server.mjs",
    "demo:purchase": "node --env-file-if-exists=.env scripts/demo-purchase.mjs",
    "issuing:spike": "node --env-file-if-exists=.env scripts/issuing-spike.mjs",
    "test": "node --env-file-if-exists=.env --test *.test.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.62",
    "@types/node": "^26.6.6",
    "ai": "7.0.127",
    "eve": "0.71.0",
    "playwright": "1.64.1",
    "stripe": "23.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "wrangler": "4.151.0"
  }
}
